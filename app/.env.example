# ─── Públicas (expuestas al navegador) ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://app.ratehub.com.ar
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ─── Servidor (nunca llegan al navegador) ──────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# OAuth de la integración GBP (cliente "RateHub – Integración GBP" en Google Cloud)
GOOGLE_GBP_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_GBP_CLIENT_SECRET=<client-secret>
GOOGLE_GBP_REDIRECT_URI=https://app.ratehub.com.ar/api/integrations/google_business_profile/callback

# Habilitar proveedores
ENABLE_GOOGLE_PROVIDER=false   # true solo cuando la API de GBP esté aprobada
ENABLE_MOCK_PROVIDER=true      # true en local y previews

# Métricas derivadas (promedios calculados al vuelo)
DERIVED_METRICS_ENABLED=true

# Cifrado de tokens OAuth. Generar con: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=<32-bytes-base64>
TOKEN_ENCRYPTION_KEY_VERSION=1

# Protección de endpoints de cron. Generar con: openssl rand -hex 32
CRON_SECRET=<secret>

# Email con Resend (dominio de envío: send.ratehub.com.ar)
RESEND_API_KEY=re_<key>
EMAIL_FROM=RateHub <hola@send.ratehub.com.ar>
